#!/usr/bin/env bash

set -euo pipefail

VISION_URL="${VISION_URL:-http://127.0.0.1:8080/v1/chat/completions}"
VISION_MODEL="${VISION_MODEL:-unsloth/Qwen3.6-35B-A3B-MTP-GGUF:Q4_K_M}"
VISION_TEMPERATURE="${VISION_TEMPERATURE:-0.1}"
VISION_MAX_TOKENS="${VISION_MAX_TOKENS:-4096}"

TMP_DIR=""
SPINNER_PID=""

usage() {
  cat >&2 <<'EOF'
Usage:
  vision [options] "prompt" image1 [image2 ...]

Send one or more images to a local vision-language model.

The prompt may request any vision task, including:
  - Image description and analysis
  - OCR and text extraction
  - UI/screenshot analysis
  - Visual comparison/diffing
  - Image understanding
  - Identifying objects, layouts, or visual relationships

Options:
  --url URL
  --model MODEL
  --temperature N
  --max-tokens N

Examples:
  vision "Describe this image in detail" screenshot.png

  vision \
    "Compare IMAGE 1 and IMAGE 2 and identify every visual difference" \
    current.png target.png

  vision \
    "Extract all visible text from this image" \
    screenshot.png
EOF
  exit 2
}

cleanup() {
  if [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]]; then
    rm -rf "$TMP_DIR"
  fi
}

trap cleanup EXIT

# ---------------------------------------------------------------------------
# Output helpers
#
# Progress output always goes to stderr so stdout contains ONLY the model
# response. This makes the script suitable for use in pipelines.
# ---------------------------------------------------------------------------

progress() {
  printf '[vision] %s\n' "$1" >&2
}

success() {
  printf '[vision] ✓ %s\n' "$1" >&2
}

error() {
  printf '[vision] ✗ %s\n' "$1" >&2
}

# ---------------------------------------------------------------------------
# Loading indicator
# ---------------------------------------------------------------------------

start_spinner() {
  local message="$1"

  # Don't animate when stderr isn't a terminal.
  if [[ ! -t 2 ]]; then
    printf '[vision] %s\n' "$message" >&2
    return
  fi

  (
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0

    while true; do
      printf '\r[vision] %s %s' "$message" "${frames[$i]}" >&2
      i=$(((i + 1) % ${#frames[@]}))
      sleep 0.1
    done
  ) &

  SPINNER_PID=$!
}

stop_spinner() {
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi

  if [[ -t 2 ]]; then
    printf '\r\033[2K' >&2
  fi
}

# ---------------------------------------------------------------------------
# Parse options
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
  --url)
    [[ $# -ge 2 ]] || usage
    VISION_URL="$2"
    shift 2
    ;;

  --model)
    [[ $# -ge 2 ]] || usage
    VISION_MODEL="$2"
    shift 2
    ;;

  --temperature)
    [[ $# -ge 2 ]] || usage
    VISION_TEMPERATURE="$2"
    shift 2
    ;;

  --max-tokens)
    [[ $# -ge 2 ]] || usage
    VISION_MAX_TOKENS="$2"
    shift 2
    ;;

  --)
    shift
    break
    ;;

  -*)
    error "Unknown option: $1"
    usage
    ;;

  *)
    break
    ;;
  esac
done

if [[ $# -lt 2 ]]; then
  usage
fi

PROMPT="$1"
shift

if [[ $# -lt 1 ]]; then
  error "At least one image is required."
  exit 2
fi

# ---------------------------------------------------------------------------
# Validate dependencies
# ---------------------------------------------------------------------------

for command in curl jq base64 file mktemp; do
  if ! command -v "$command" >/dev/null 2>&1; then
    error "Required command not found: $command"
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# Validate numeric options before passing them to jq --argjson.
# ---------------------------------------------------------------------------

if ! jq -en --argjson value "$VISION_TEMPERATURE" '$value | numbers' \
  >/dev/null 2>&1; then
  error "Invalid temperature: $VISION_TEMPERATURE"
  exit 2
fi

if ! jq -en --argjson value "$VISION_MAX_TOKENS" '$value | numbers' \
  >/dev/null 2>&1; then
  error "Invalid max-tokens value: $VISION_MAX_TOKENS"
  exit 2
fi

# ---------------------------------------------------------------------------
# Validate images
# ---------------------------------------------------------------------------

IMAGE_COUNT=$#

progress "Checking $IMAGE_COUNT image(s)..."

for image in "$@"; do
  if [[ ! -f "$image" ]]; then
    error "Image does not exist: $image"
    exit 1
  fi

  if [[ ! -r "$image" ]]; then
    error "Image is not readable: $image"
    exit 1
  fi

  mime_type="$(file --mime-type -b "$image")"

  case "$mime_type" in
  image/jpeg | image/png | image/webp | image/gif)
    ;;
  *)
    error "Unsupported image MIME type '$mime_type': $image"
    exit 1
    ;;
  esac
done

success "Images validated"

# ---------------------------------------------------------------------------
# Create temporary workspace
# ---------------------------------------------------------------------------

TMP_DIR="$(mktemp -d)"

REQUEST_FILE="$TMP_DIR/request.json"

# ---------------------------------------------------------------------------
# Build request
#
# IMPORTANT:
#
# Multiple images are deliberately represented as separate user messages
# rather than putting every image into one content array.
#
# This is more reliable with llama.cpp's OpenAI-compatible multimodal
# endpoint and Qwen vision chat templates, particularly when the model needs
# to distinguish IMAGE 1 from IMAGE 2 in a visual comparison.
#
# The textual prompt is placed in the first message, followed by one message
# per image. Each image is explicitly labeled so the model has a stable
# correspondence between the image's position and the user's instructions.
#
# We never store base64 data in shell variables. Large screenshots can easily
# exceed shell argument/environment limits.
# ---------------------------------------------------------------------------

progress "Building vision model request..."

jq -n \
  --arg model "$VISION_MODEL" \
  --arg prompt "$PROMPT" \
  --argjson temperature "$VISION_TEMPERATURE" \
  --argjson max_tokens "$VISION_MAX_TOKENS" \
  '{
    model: $model,
    temperature: $temperature,
    max_tokens: $max_tokens,
    messages: [
      {
        role: "user",
        content: [
          {
            type: "text",
            text: $prompt
          }
        ]
      }
    ]
  }' >"$REQUEST_FILE"

IMAGE_INDEX=0

for image in "$@"; do
  IMAGE_NUMBER=$((IMAGE_INDEX + 1))

  progress "Encoding image $IMAGE_NUMBER/$IMAGE_COUNT: $image"

  mime_type="$(file --mime-type -b "$image")"
  encoded_file="$TMP_DIR/image-${IMAGE_INDEX}.b64"

  # Write base64 directly to disk rather than storing it in a shell variable.
  base64 -w 0 "$image" >"$encoded_file"

  # Add each image as its own user message. This avoids the multi-image
  # content-array behavior that can cause some vision chat templates to lose
  # track of which image corresponds to which part of the prompt.
  jq \
    --rawfile b64 "$encoded_file" \
    --arg mime "$mime_type" \
    --arg image_number "$IMAGE_NUMBER" \
    '.messages += [{
      role: "user",
      content: [
        {
          type: "text",
          text: ("IMAGE " + $image_number)
        },
        {
          type: "image_url",
          image_url: {
            url: ("data:" + $mime + ";base64," + $b64)
          }
        }
      ]
    }]' \
    "$REQUEST_FILE" >"$REQUEST_FILE.tmp"

  mv "$REQUEST_FILE.tmp" "$REQUEST_FILE"

  IMAGE_INDEX=$((IMAGE_INDEX + 1))
done

success "Request prepared"

# ---------------------------------------------------------------------------
# Send request
# ---------------------------------------------------------------------------

RESPONSE_FILE="$TMP_DIR/response.json"

start_spinner "Waiting for vision model response..."

CURL_STATUS=0

HTTP_STATUS="$(
  curl \
    --silent \
    --show-error \
    --write-out '%{http_code}' \
    --output "$RESPONSE_FILE" \
    --header 'Content-Type: application/json' \
    --data-binary "@$REQUEST_FILE" \
    "$VISION_URL"
)" || CURL_STATUS=$?

stop_spinner

if [[ "$CURL_STATUS" -ne 0 ]]; then
  error "Could not connect to vision server"
  exit "$CURL_STATUS"
fi

if [[ ! "$HTTP_STATUS" =~ ^[0-9]+$ ]]; then
  error "Vision server returned an invalid HTTP status: $HTTP_STATUS"

  if [[ -s "$RESPONSE_FILE" ]]; then
    cat "$RESPONSE_FILE" >&2
  fi

  exit 1
fi

if [[ "$HTTP_STATUS" -lt 200 || "$HTTP_STATUS" -ge 300 ]]; then
  error "Vision model returned HTTP $HTTP_STATUS"
  cat "$RESPONSE_FILE" >&2
  exit 1
fi

success "Vision model response received"

# ---------------------------------------------------------------------------
# Extract response
# ---------------------------------------------------------------------------

if ! jq -e '.choices[0].message.content' \
  "$RESPONSE_FILE" >/dev/null 2>&1; then

  error "Vision server returned an unexpected response:"
  cat "$RESPONSE_FILE" >&2
  exit 1
fi

jq -r '.choices[0].message.content' "$RESPONSE_FILE"
